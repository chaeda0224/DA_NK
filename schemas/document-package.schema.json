{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://da-nk.local/schemas/document-package.schema.json",
  "title": "DA_NK Rodong DocumentPackage",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_id",
    "document",
    "segments",
    "assets",
    "text_versions",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_id": {
      "const": "rodong"
    },
    "document": {
      "$ref": "#/$defs/document"
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/segment"
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/asset"
      }
    },
    "text_versions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/textVersion"
      },
      "minItems": 1
    },
    "annotations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/annotation"
      },
      "default": []
    },
    "reviews": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/review"
      },
      "default": []
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "document_id",
        "issue_id",
        "document_type",
        "publication",
        "date",
        "title",
        "verification_status"
      ],
      "properties": {
        "document_id": {
          "type": "string",
          "pattern": "^rodong-[0-9]{4}-[0-9]{2}-[0-9]{2}-a[0-9]{3}$"
        },
        "issue_id": {
          "type": "string",
          "pattern": "^rodong-[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "document_type": {
          "const": "newspaper-article"
        },
        "publication": {
          "const": "로동신문"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reporter": {
          "type": [
            "string",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ]
        },
        "verification_status": {
          "enum": [
            "unverified",
            "needs_review",
            "reviewed",
            "verified"
          ]
        },
        "legacy_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      }
    },
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "segment_id",
        "kind",
        "order"
      ],
      "properties": {
        "segment_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "title",
            "subtitle",
            "body",
            "caption",
            "table"
          ]
        },
        "order": {
          "type": "integer",
          "minimum": 0
        },
        "page": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "text_version_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_id",
        "kind",
        "logical_path",
        "sha256"
      ],
      "properties": {
        "asset_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "source-pdf",
            "source-word",
            "page-image",
            "article-crop",
            "embedded-image"
          ]
        },
        "logical_path": {
          "type": "string",
          "minLength": 1,
          "not": {
            "pattern": "^[A-Za-z]:[\\\\/]"
          }
        },
        "sha256": {
          "type": "string",
          "pattern": "^[A-Fa-f0-9]{64}$"
        },
        "media_type": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "textVersion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text_version_id",
        "kind",
        "content",
        "created_at"
      ],
      "properties": {
        "text_version_id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "ocr",
            "normalized",
            "corrected"
          ]
        },
        "content": {
          "type": "string"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "tool": {
          "type": [
            "string",
            "null"
          ]
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "annotation": {
      "type": "object",
      "required": [
        "annotation_id",
        "kind",
        "value"
      ],
      "properties": {
        "annotation_id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "value": {}
      }
    },
    "review": {
      "type": "object",
      "required": [
        "review_id",
        "status",
        "reviewed_at"
      ],
      "properties": {
        "review_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "approved",
            "rejected",
            "deferred"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        },
        "note": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ingest_run_id",
        "created_at",
        "source_refs"
      ],
      "properties": {
        "ingest_run_id": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_refs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "tool_versions": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    }
  }
}
