{
  "name": "da-nk-core",
  "version": "0.1.1",
  "private": true,
  "description": "Tools for OCR of Rodong Sinmun newspaper articles; this alpha provides reviewed annotation export, document models, and local search.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/chaeda0224/DA_NK.git"
  },
  "scripts": {
    "demo": "node examples/search-demo.mjs",
    "start": "node apps/search-api/server.mjs",
    "test": "node --test",
    "ocr:setup": "node scripts/setup-ocr-python.mjs",
    "ocr:profiles": "node scripts/run-ocr-python.mjs -m nk_ocr_kit.cli profiles",
    "ocr:build-layout": "node scripts/run-ocr-python.mjs -m nk_ocr_kit.cli build-layout-dataset",
    "test:ocr": "node scripts/run-ocr-python.mjs -m unittest discover -s tests/python -v"
  }
}
